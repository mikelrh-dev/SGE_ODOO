<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category" model="ir.module.category">
        <field name="name">Gestion de Incidencias</field>
        <field name="description">Incidencias</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
       <!-- <field name="implied_ids" eval="[(4, ref('group_user'))]"/> -->
    </record>

<record id="incidencia_user" model="ir.rule">
    <field name="name">Usuario Incidencias</field>
    <field name="model_id" ref="model_reto1_incidencias_incidencia"/>
    <field name="groups" eval="[(4, ref('group_user'))]"/>
</record>

<record id="incidencia_manager" model="ir.rule">
    <field name="name">Manager Incidencias</field>
    <field name="model_id" ref="model_reto1_incidencias_incidencia"/>
    <field name="groups" eval="[(4, ref('group_manager'))]"/>
</record>

<record id="comentario_user" model="ir.rule">
    <field name="name">Usuario Comentario</field>
    <field name="model_id" ref="model_reto1_incidencias_comentario"/>
    <field name="groups" eval="[(4, ref('group_user'))]"/>
</record>

<record id="adjunto_user" model="ir.rule">
    <field name="name">Usuario Adjuntos</field>
    <field name="model_id" ref="model_reto1_incidencias_adjunto"/>
    <field name="groups" eval="[(4, ref('group_user'))]"/>
</record>

</odoo>
