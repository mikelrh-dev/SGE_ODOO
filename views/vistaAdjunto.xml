<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="vista_adjunto_search" model="ir.ui.view">
        <field name="name">reto1_incidencias.adjunto.search</field>
        <field name="model">reto1_incidencias.adjunto</field>
        <field name="arch" type="xml">
            <search string="Buscar Adjuntos">
                <field name="nombre_archivo"/>
                <field name="id_incidencia"/>
                <field name="id_comentario"/>

                <filter string="Archivos Recientes" name="recent" domain="[('fecha_subida', '>=', context_today().strftime('%Y-%m-%d'))]"/>

                <group expand="0" string="Agrupar por">
                    <filter string="Incidencia" name="group_by_incidencia" context="{'group_by': 'id_incidencia'}"/>
                    <filter string="Fecha" name="group_by_fecha" context="{'group_by': 'fecha_subida'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vista_adjunto_tree" model="ir.ui.view">
        <field name="name">reto1_incidencias.adjunto.tree</field>
        <field name="model">reto1_incidencias.adjunto</field>
        <field name="arch" type="xml">
            <tree string="Adjuntos" decoration-info="fecha_subida == current_date">
                <field name="nombre_archivo"/>
                <field name="id_incidencia" optional="show"/>
                <field name="id_comentario" optional="hide"/>
                <field name="fecha_subida"/>
            </tree>
        </field>
    </record>

    <record id="vista_adjunto_form" model="ir.ui.view">
        <field name="name">reto1_incidencias.adjunto.form</field>
        <field name="model">reto1_incidencias.adjunto</field>
        <field name="arch" type="xml">
            <form string="Adjunto">
                <sheet>
                    <div class="oe_title">
                        <label for="nombre_archivo" class="oe_edit_only"/>
                        <h1><field name="nombre_archivo" placeholder="ej. captura_error.png"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="id_incidencia"/>
                            <field name="id_comentario"/>
                        </group>
                        <group>
                            <field name="fecha_subida"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vista_adjunto_form_inherit" model="ir.ui.view">
        <field name="name">reto1_incidencias.adjunto.form.inherit</field>
        <field name="model">reto1_incidencias.adjunto</field>
        <field name="inherit_id" ref="vista_adjunto_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <notebook>
                    <page string="Detalles Técnicos">
                        <group>
                            <field name="ruta_archivo"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_reto1_adjunto_kanban" model="ir.ui.view">
        <field name="name">reto1_incidencias.adjunto.kanban</field>
        <field name="model">reto1_incidencias.adjunto</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image" style="display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-paperclip fa-3x" style="color: #7C7BAD;" title="Adjunto"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <span><field name="nombre_archivo"/></span>
                                </strong>
                                <ul>
                                    <li><i class="fa fa-calendar"/> <field name="fecha_subida"/></li>
                                    <li><i class="fa fa-tag"/> Incidencia: <field name="id_incidencia"/></li>
                                    <li><i class="fa fa-comment"/> Comentario: <field name="id_comentario"/></li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_adjunto" model="ir.actions.act_window">
        <field name="name">Adjuntos</field>
        <field name="res_model">reto1_incidencias.adjunto</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="search_view_id" ref="vista_adjunto_search"/>
    </record>

</odoo>