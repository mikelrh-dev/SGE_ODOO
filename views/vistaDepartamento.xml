<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_department_form_inherit_stats" model="ir.ui.view">
        <field name="name">hr.department.form.inherit.stats</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/group" position="inside">
                <field name="descripcion"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Incidencias del Departamento">
                        <field name="incidencia_ids">
                            <tree editable="bottom">
                                <field name="titulo"/>
                                <field name="fecha_creacion"/>
                                <field name="estado_actual" widget="badge"
                                       decoration-info="estado_actual == 'en_proceso'"
                                       decoration-success="estado_actual in ('resuelta', 'cerrada')"/>
                            </tree>
                        </field>
                    </page>

                    <page string="Análisis de Estadísticas">
                        <group>
                            <p class="text-muted">
                                <i class="fa fa-info-circle"/> Histórico de rendimiento calculado para este departamento.
                            </p>
                        </group>
                        <field name="estadistica_ids" readonly="1">
                            <tree>
                                <field name="fecha"/>
                                <field name="total_incidencias" sum="Total Histórico"/>
                                <field name="incidencias_finalizadas" string="Resueltas"/>
                                <field name="porcentaje_resueltas" widget="progressbar" string="% Éxito"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_hr_department_tree_inherit" model="ir.ui.view">
        <field name="name">hr.department.tree.inherit</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="descripcion" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>