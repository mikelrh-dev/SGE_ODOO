<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_encuesta_tree" model="ir.ui.view">
        <field name="name">reto1_incidencias.encuesta.tree</field>
        <field name="model">reto1_incidencias.encuesta</field>
        <field name="arch" type="xml">
            <tree decoration-danger="puntuacion in ('1', '2')" decoration-success="puntuacion == '5'">
                <field name="id_incidencia"/>
                <field name="id_empleado"/>
                <field name="canal"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="resultado_texto" decoration-success="resultado_texto == 'POSITIVO'" decoration-danger="resultado_texto == 'NEGATIVO'" widget="badge"/>
                <field name="puntuacion" widget="badge"
                        decoration-danger="puntuacion in ('1', '2')"
                        decoration-warning="puntuacion == '3'"
                       decoration-success="puntuacion in ('4', '5')"/>
                <field name="fecha_respuesta"/>
            </tree>
        </field>
    </record>

    <record id="view_encuesta_form" model="ir.ui.view">
        <field name="name">reto1_incidencias.encuesta.form</field>
        <field name="model">reto1_incidencias.encuesta</field>
        <field name="arch" type="xml">
            <form string="Encuesta">
                <sheet>
                    <group>
                        <group string="Detalles">
                            <field name="id_incidencia"/>
                            <field name="id_empleado"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="canal"/>
                        </group>

                        <group string="Valoración">
                            <field name="puntuacion" widget="radio"/>
                            <field name="fecha_respuesta"/>
                            <field name="resultado_texto" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="comentario" placeholder="Escribe aquí los comentarios del cliente..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

<record id="view_encuesta_kanban" model="ir.ui.view">
        <field name="name">reto1_incidencias.encuesta.kanban</field>
        <field name="model">reto1_incidencias.encuesta</field>
        <field name="arch" type="xml">
            <kanban default_group_by="puntuacion">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <img src="/Reto1_incidencias/static/description/icon.png"
                                             style="width: 20px; height: 20px; margin-right: 5px;"
                                             alt="Logo"/>
                                        <field name="id_incidencia"/>
                                    </strong>
                                </div>
                            </div>

                            <div>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </div>

                            <div class="mt-2">
                                <field name="puntuacion" widget="badge"
                                    decoration-danger="puntuacion in ('1', '2')"
                                    decoration-warning="puntuacion == '3'"
                                    decoration-success="puntuacion in ('4', '5')"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_encuesta_search" model="ir.ui.view">
        <field name="name">reto1_incidencias.encuesta.search</field>
        <field name="model">reto1_incidencias.encuesta</field>
        <field name="arch" type="xml">
            <search>
                <field name="id_incidencia"/>
                <field name="id_empleado"/>
                <filter string="Malas notas" name="bad" domain="[('puntuacion','in',['1','2'])]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empleado" name="group_emp" context="{'group_by':'id_empleado'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_encuesta_window" model="ir.actions.act_window">
        <field name="name">Encuestas</field>
        <field name="res_model">reto1_incidencias.encuesta</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>



    <menuitem id="menu_reto1_encuesta"
              name="Encuestas"
              parent="menu_reto1_root"
              sequence="3"
              action="action_encuesta_window"/>

</odoo>