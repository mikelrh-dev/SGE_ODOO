<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_estadisticas_search" model="ir.ui.view">
        <field name="name">reto1_incidencias.estadisticas.search</field>
        <field name="model">reto1_incidencias.estadisticas</field>
        <field name="arch" type="xml">
            <search string="Buscar Estadísticas">
                <field name="id_estadistica"/>
                <field name="fecha"/>
                <field name="id_departamento"/>
                <filter name="hoy" string="Hoy" domain="[('fecha','=', context_today())]"/>
                <filter name="con_incidencias" string="Con Incidencias" domain="[('total_incidencias','>',0)]"/>
                <filter name="porcentaje_alto" string="> 50% Resueltas" domain="[('porcentaje_resueltas','>',50)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_fecha" string="Fecha" context="{'group_by':'fecha'}"/>
                    <filter name="group_departamento" string="Departamento" context="{'group_by':'id_departamento'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_estadisticas_tree" model="ir.ui.view">
        <field name="name">reto1_incidencias.estadisticas.tree</field>
        <field name="model">reto1_incidencias.estadisticas</field>
        <field name="arch" type="xml">
            <tree string="Listado de Estadísticas">
                <field name="id_estadistica"/>
                <field name="fecha"/>
                <field name="id_departamento"/>
                <field name="total_incidencias"/>
                <field name="incidencias_finalizadas"/>
                <field name="tiempo_promedio_resolucion"/>
                <field name="porcentaje_resueltas" widget="progressbar"/>
            </tree>
        </field>
    </record>

    <record id="view_estadisticas_form" model="ir.ui.view">
        <field name="name">reto1_incidencias.estadisticas.form</field>
        <field name="model">reto1_incidencias.estadisticas</field>
        <field name="arch" type="xml">
            <form string="Estadística">
                <sheet>
                    <div class="oe_title">
                        <label for="id_estadistica" class="oe_edit_only"/>
                        <h1><field name="id_estadistica"/></h1>
                    </div>
                    <group>
                        <group string="Datos Principales">
                            <field name="fecha"/>
                            <field name="id_departamento" options="{'no_create': True}"/>
                        </group>
                        <group string="Métricas Calculadas">
                            <field name="total_incidencias"/>
                            <field name="incidencias_finalizadas"/>
                            <field name="tiempo_promedio_resolucion"/>
                            <field name="porcentaje_resueltas" widget="percentpie"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_estadisticas_kanban" model="ir.ui.view">
        <field name="name">reto1_incidencias.estadisticas.kanban</field>
        <field name="model">reto1_incidencias.estadisticas</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id_estadistica"/>
                <field name="fecha"/>
                <field name="id_departamento"/>
                <field name="total_incidencias"/>
                <field name="porcentaje_resueltas"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image" style="display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-bar-chart fa-3x" style="color: #7C7BAD;" title="Estadísticas"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <span>ID: <field name="id_estadistica"/></span>
                                </strong>
                                <ul>
                                    <li><i class="fa fa-calendar"/> Fecha: <field name="fecha"/></li>
                                    <li><i class="fa fa-building"/> Dpto: <field name="id_departamento"/></li>
                                    <li><i class="fa fa-ticket"/> Total: <field name="total_incidencias"/></li>
                                    <li><i class="fa fa-check-circle"/> Resueltas: <field name="porcentaje_resueltas"/>%</li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_estadisticas" model="ir.actions.act_window">
        <field name="name">Estadísticas de Incidencias</field>
        <field name="res_model">reto1_incidencias.estadisticas</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="search_view_id" ref="view_estadisticas_search"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Crea tu primera estadística
          </p>
        </field>
    </record>

</odoo>
